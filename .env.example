# Credenziali Supabase — copia questo file in .env.local e riempi i due valori.
# Li trovi nel pannello Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Facoltativa ma consigliata: chiave per Google Books.
#
# Senza, le richieste finiscono in una quota condivisa e anonima che si esaurisce
# di continuo: Google risponde "429 Quota exceeded" e la ricerca per ISBN smette
# di funzionare senza preavviso. L'app ripiega su OpenLibrary, che però sui libri
# italiani ha parecchi buchi.
#
# Si ottiene gratis in due minuti su https://console.cloud.google.com:
# crea un progetto → abilita "Books API" → Credenziali → Crea credenziali → Chiave API.
# Mille richieste al giorno, più che sufficienti.
GOOGLE_BOOKS_API_KEY=

# Indirizzo pubblico del sito, usato per le anteprime dei link condivisi.
# Su Vercel viene dedotto da solo: serve solo con un dominio personalizzato.
NEXT_PUBLIC_SITE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# SOLO PER LAVORARE IN LOCALE — da non impostare mai su Vercel
# ─────────────────────────────────────────────────────────────────────────────

# Entra senza fare l'accesso, vedendo comunque i libri veri.
#
# La chiave `service_role` scavalca le regole per utente del database: senza,
# un finto accesso mostrerebbe l'applicazione completamente vuota, perché ogni
# tabella lascia leggere soltanto le righe di chi le ha inserite.
#
# Dove si trova: pannello Supabase → Project Settings → API Keys → `service_role`
# (è quella marcata "secret", non la `anon`/`publishable`).
#
# Tre motivi per cui non può sfuggire: il codice la ignora quando NODE_ENV vale
# "production", non ha il prefisso NEXT_PUBLIC_ quindi non entra mai nel pacchetto
# che arriva al browser, e vive in .env.local che .gitignore esclude.
#
# Per tornare alla schermata di accesso basta commentare questa riga.
SUPABASE_SERVICE_ROLE_KEY=

# Chi essere quando si entra senza accesso. Da riempire solo se sul progetto
# Supabase c'è più di un utente: altrimenti viene preso da sé l'unico che c'è.
LIBRERIA_UTENTE_LOCALE=
