# Credenziali Supabase — copia questo file in .env.local e riempi i due valori.
# Li trovi nel pannello Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Facoltativa ma consigliata: chiave per Google Books.
#
# Senza, le richieste finiscono in una quota condivisa e anonima che si esaurisce
# di continuo: Google risponde "429 Quota exceeded" e la ricerca per ISBN smette
# di funzionare senza preavviso. L'app ripiega su OpenLibrary, che però sui libri
# italiani ha parecchi buchi.
#
# Si ottiene gratis in due minuti su https://console.cloud.google.com:
# crea un progetto → abilita "Books API" → Credenziali → Crea credenziali → Chiave API.
# Mille richieste al giorno, più che sufficienti.
GOOGLE_BOOKS_API_KEY=

# Indirizzo pubblico del sito, usato per le anteprime dei link condivisi.
# Su Vercel viene dedotto da solo: serve solo con un dominio personalizzato.
NEXT_PUBLIC_SITE_URL=
